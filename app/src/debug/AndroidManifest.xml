<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Désactive l'auto-initialisation du ContentProvider pour laisser Application.onCreate() initialiser Sentry -->
        <meta-data
            android:name="io.sentry.auto-init.enable"
            android:value="false" />
        <meta-data
            android:name="io.sentry.enabled"
            android:value="true" />
    </application>
</manifest>
